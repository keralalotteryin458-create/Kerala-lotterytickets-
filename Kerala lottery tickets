<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>RUPESH LOTTERY AGENCY - Kerala Mega Jackpot</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            --bg-color: #0b0c10;
            --card-bg: #12141a;
            --card-border: #232733;
            --gold-primary: #f39c12;
            --gold-gradient: linear-gradient(135deg, #f39c12, #f1c40f);
            --gold-text: linear-gradient(180deg, #ffe066 0%, #d4af37 100%);
            --whatsapp-green: #25d366;
            --text-white: #ffffff;
            --text-gray: #a0a5b5;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Poppins', sans-serif;
        }

        body {
            background-color: var(--bg-color);
            color: var(--text-white);
            overflow-x: hidden;
        }

        /* NAVBAR */
        nav {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 18px 5%;
            background-color: rgba(11, 12, 16, 0.95);
            border-bottom: 1px solid var(--card-border);
            position: sticky;
            top: 0;
            z-index: 100;
        }

        .logo-container {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .logo-icon {
            width: 42px;
            height: 42px;
            border-radius: 50%;
            border: 2px solid var(--gold-primary);
            display: flex;
            align-items: center;
            justify-content: center;
            background: radial-gradient(circle, #2b2100 0%, #000000 100%);
            color: var(--gold-primary);
            font-weight: bold;
            font-size: 20px;
        }

        .logo-text h2 {
            font-size: 18px;
            letter-spacing: 1px;
            color: #fff;
            line-height: 1;
        }

        .logo-text p {
            font-size: 9px;
            color: var(--gold-primary);
            letter-spacing: 1.5px;
            margin-top: 3px;
        }

        .nav-links {
            display: flex;
            gap: 25px;
            list-style: none;
        }

        .nav-links a {
            color: var(--text-gray);
            text-decoration: none;
            font-size: 13px;
            font-weight: 500;
            transition: 0.3s;
            text-transform: uppercase;
        }

        .nav-links a.active, .nav-links a:hover {
            color: var(--gold-primary);
        }

        .nav-wa-btn {
            background: #122919;
            border: 1px solid var(--whatsapp-green);
            color: var(--whatsapp-green);
            padding: 8px 16px;
            border-radius: 30px;
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 12px;
            font-weight: 600;
            text-decoration: none;
        }

        .container {
            max-width: 1000px;
            margin: 0 auto;
            padding: 20px 15px;
        }

        /* HERO SECTION */
        .hero {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
            align-items: center;
            padding: 30px 0;
        }

        .live-tag {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: rgba(243, 156, 18, 0.1);
            border: 1px solid var(--gold-primary);
            color: var(--gold-primary);
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 11px;
            font-weight: 700;
            margin-bottom: 15px;
        }

        .live-tag::before {
            content: '';
            width: 8px;
            height: 8px;
            background-color: var(--gold-primary);
            border-radius: 50%;
        }

        .hero-left h1 {
            font-size: 38px;
            font-weight: 800;
            line-height: 1.1;
            margin-bottom: 15px;
            background: linear-gradient(180deg, #ffffff 0%, #dddddd 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .hero-left h1 span {
            background: var(--gold-text);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            display: block;
        }

        .tagline {
            font-size: 15px;
            font-weight: 600;
            color: var(--gold-primary);
            margin-bottom: 5px;
        }

        .sub-tagline {
            font-size: 12px;
            color: var(--text-gray);
            margin-bottom: 20px;
        }

        .badges {
            display: flex;
            gap: 15px;
        }

        .badge-item {
            display: flex;
            align-items: center;
            gap: 8px;
            background: var(--card-bg);
            border: 1px solid var(--card-border);
            padding: 8px 12px;
            border-radius: 8px;
            font-size: 11px;
            color: var(--text-white);
        }

        .badge-item i {
            color: var(--gold-primary);
        }

        /* JACKPOT EMBLEM (RIGHT HERO) */
        .jackpot-circle {
            width: 280px;
            height: 280px;
            margin: 0 auto;
            border-radius: 50%;
            background: radial-gradient(circle, #3d2d00 0%, #12141a 100%);
            border: 6px solid var(--gold-primary);
            box-shadow: 0 0 30px rgba(243, 156, 18, 0.3);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            position: relative;
            text-align: center;
        }

        .crown-icon {
            position: absolute;
            top: -35px;
            font-size: 45px;
            color: var(--gold-primary);
            filter: drop-shadow(0 0 10px rgba(243,156,18,0.8));
        }

        .jackpot-circle p {
            font-size: 12px;
            color: var(--gold-primary);
            font-weight: 700;
            letter-spacing: 2px;
        }

        .jackpot-circle h2 {
            font-size: 48px;
            font-weight: 900;
            color: #fff;
            line-height: 1;
            margin: 5px 0;
            text-shadow: 0 0 10px rgba(0,0,0,0.5);
        }

        .jackpot-circle h3 {
            font-size: 20px;
            color: #fff;
            letter-spacing: 3px;
        }

        .stars {
            color: var(--gold-primary);
            font-size: 12px;
            margin-top: 8px;
        }

        /* TIMER & STOCK BAR */
        .status-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 15px;
            margin: 25px 0;
        }

        .timer-card, .stock-card {
            background: var(--card-bg);
            border: 1px solid var(--card-border);
            padding: 15px;
            border-radius: 12px;
        }

        .card-label {
            font-size: 11px;
            color: var(--gold-primary);
            font-weight: 700;
            letter-spacing: 1px;
            margin-bottom: 10px;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .timer-boxes {
            display: flex;
            gap: 12px;
        }

        .time-box span {
            display: block;
            font-size: 20px;
            font-weight: 800;
            color: #fff;
        }

        .time-box label {
            font-size: 9px;
            color: var(--text-gray);
        }

        .progress-bar-bg {
            background: #202430;
            height: 8px;
            border-radius: 10px;
            margin-top: 15px;
            overflow: hidden;
        }

        .progress-bar-fill {
            width: 75%;
            height: 100%;
            background: var(--gold-gradient);
            border-radius: 10px;
        }

        /* FEATURES STRIP */
        .features-strip {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 10px;
            margin-bottom: 30px;
        }

        .feature-item {
            background: var(--card-bg);
            border: 1px solid var(--card-border);
            padding: 12px;
            border-radius: 8px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .feature-item i {
            font-size: 18px;
            color: var(--gold-primary);
        }

        .feature-item div h4 {
            font-size: 11px;
            color: #fff;
        }

        .feature-item div p {
            font-size: 9px;
            color: var(--text-gray);
        }

        /* TICKET SELECTION GRID */
        .section-header {
            text-align: center;
            margin-bottom: 20px;
        }

        .section-header h2 {
            font-size: 22px;
            color: #fff;
            letter-spacing: 1px;
        }

        .section-header p {
            font-size: 12px;
            color: var(--text-gray);
        }

        .tickets-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 12px;
            margin-bottom: 25px;
        }

        .ticket-item {
            background: var(--card-bg);
            border: 1px solid var(--card-border);
            border-radius: 8px;
            padding: 15px 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            cursor: pointer;
            transition: 0.2s;
            position: relative;
        }

        .ticket-item:hover {
            border-color: var(--gold-primary);
        }

        .ticket-item.selected {
            border-color: var(--gold-primary);
            background: rgba(243, 156, 18, 0.08);
        }

        .ticket-item.selected::after {
            content: '✓';
            position: absolute;
            top: -6px;
            right: -6px;
            background: var(--gold-primary);
            color: #000;
            width: 16px;
            height: 16px;
            border-radius: 50%;
            font-size: 10px;
            font-weight: bold;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .ticket-icon {
            color: var(--gold-primary);
            font-size: 16px;
        }

        .ticket-info label {
            display: block;
            font-size: 9px;
            color: var(--text-gray);
            line-height: 1;
        }

        .ticket-info span {
            font-size: 16px;
            font-weight: 700;
            color: #fff;
        }

        /* BOTTOM BOOKING BAR */
        .booking-bar {
            background: var(--card-bg);
            border: 1px solid var(--card-border);
            padding: 15px 20px;
            border-radius: 12px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 35px;
        }

        .summary-box {
            display: flex;
            gap: 30px;
        }

        .sum-item label {
            display: block;
            font-size: 10px;
            color: var(--text-gray);
        }

        .sum-item span {
            font-size: 18px;
            font-weight: 800;
            color: var(--gold-primary);
        }

        .btn-wa-book {
            background: var(--whatsapp-green);
            color: #fff;
            padding: 12px 25px;
            border-radius: 8px;
            text-decoration: none;
            font-weight: 700;
            font-size: 14px;
            display: flex;
            align-items: center;
            gap: 10px;
            border: none;
            cursor: pointer;
        }

        /* THREE PROMO BOXES */
        .promo-boxes {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 15px;
            margin-bottom: 40px;
        }

        .promo-card {
            background: var(--card-bg);
            border: 1px solid var(--card-border);
            padding: 15px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .promo-card i {
            font-size: 24px;
            color: var(--gold-primary);
        }

        .promo-card h4 {
            font-size: 12px;
            color: #fff;
        }

        .promo-card p {
            font-size: 10px;
            color: var(--text-gray);
        }

        /* FOOTER */
        footer {
            border-top: 1px solid var(--card-border);
            padding: 40px 0 20px 0;
            display: grid;
            grid-template-columns: 1.5fr 1fr 1fr 1fr;
            gap: 20px;
        }

        .footer-col h4 {
            font-size: 12px;
            color: #fff;
            margin-bottom: 15px;
            letter-spacing: 1px;
        }

        .footer-col ul {
            list-style: none;
        }

        .footer-col ul li {
            margin-bottom: 8px;
        }

        .footer-col ul li a {
            color: var(--text-gray);
            font-size: 11px;
            text-decoration: none;
        }

        .footer-col p {
            color: var(--text-gray);
            font-size: 11px;
            line-height: 1.5;
        }

        .contact-item {
            display: flex;
            align-items: center;
            gap: 8px;
            color: var(--text-gray);
            font-size: 11px;
            margin-bottom: 8px;
        }

        .social-icons {
            display: flex;
            gap: 10px;
        }

        .social-icons a {
            width: 30px;
            height: 30px;
            border-radius: 50%;
            background: #1c202b;
            color: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 12px;
            text-decoration: none;
        }

        /* RESPONSIVE DESIGN FOR MOBILE */
        @media (max-width: 768px) {
            .hero {
                grid-template-columns: 1fr;
                text-align: center;
            }

            .badges {
                justify-content: center;
            }

            .status-row, .features-strip, .promo-boxes, footer {
                grid-template-columns: 1fr;
            }

            .tickets-grid {
                grid-template-columns: repeat(2, 1fr);
            }

            .nav-links {
                display: none;
            }
        }
    </style>
</head>
